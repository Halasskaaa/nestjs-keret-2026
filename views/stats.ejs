<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <a href="/">Főoldal</a>
    <a href="/all">Összes kiadás</a>
    <a href="/top3">Top három kiadás</a>
    <a href="/search">Keresés</a>
    <a href="/expensive">Expensive</a>
    <a href="/stats">Statisztikák</a>

    <h2>Statisztikák</h2>

    <p>Kiadások száma: <strong><%= count %></strong></p>
    <p>Összes kiadások összege: <strong><%= total %> Ft</strong></p>
    <p>Átlagos kiadás: <strong><%= average.toFixed(2) %> Ft</strong></p>

    <h2>Statisztikák kategóriánként</h2>
    
    <table>
        <thead>
            <tr>
                <th>Kategória</th>
                <th>Darabszám</th>
                <th>Összeg</th>
                <th>Átlag</th>
            </tr>
        </thead>
        <tbody>
            <% categoryStats.forEach(stats => { %>
                <tr class="<%= stats.category %>">
                    <td><%= stats.category %></td>
                    <td><%= stats.count %></td>
                    <td><%= stats.total %> Ft</td>
                    <td><%= stats.average.toFixed(2) %> Ft</td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    
</body>
</html>